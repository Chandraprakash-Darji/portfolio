---
import { getCollection } from 'astro:content';
import { postTransitionName } from '../lib/transition';
import { formatPostDate } from '../lib/utils';
import TuiCard from './TuiCard.astro';

interface Props {
  collection: 'blog' | 'snippets';
  limit?: number;
}

const { collection, limit } = Astro.props;
const hrefBase = collection === 'snippets' ? '/writing' : '/writing';

const all = await getCollection(collection);
let posts = all
  .filter((p) => p.data.published !== false)
  .toSorted((a, b) => b.data.publishedAt?.localeCompare(a.data.publishedAt ?? '') ?? 0);

if (limit) posts = posts.slice(0, limit);
---

<div class="flex flex-col gap-2">
  {posts.map((post) => {
    const slug = post.id.replace(/\.mdx$/, '');
    const { title, publishedAt, categories = [] } = post.data;
    const date = formatPostDate(publishedAt);

    return (
      <TuiCard
        href={`${hrefBase}/${slug}`}
        ariaLabel={`Read ${title}`}
        class="flex flex-col p-3 text-card-foreground transition-colors hover:bg-muted/30"
        onclick={`window.umami?.track('card-click',{collection:'${collection}',slug:'${slug}'})`}
      >
        <div class="flex items-center justify-between gap-4">
          <div class="min-w-0">
            {categories.length > 0 && (
              <div class="mb-1 flex flex-wrap gap-1.5">
                {categories.slice(0, 2).map((c) => (
                  <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground/60">
                    {c.name}
                  </span>
                ))}
              </div>
            )}
            <h3
              style={`view-transition-name: ${postTransitionName(title)}`}
              class="truncate text-sm font-medium leading-snug text-foreground"
            >
              {title}
            </h3>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <span class="font-mono text-[10px] text-muted-foreground/50">{date}</span>
            <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-7-7 7 7-7 7" />
            </svg>
          </div>
        </div>
      </TuiCard>
    );
  })}
</div>

<style>
  .corner-card { position: relative; }

  .corner {
    position: absolute;
    width: 10px;
    height: 10px;
    z-index: 10;
    border-color: hsl(var(--foreground) / 0.35);
    border-style: solid;
    border-width: 0;
  }
  .corner.tl { top: 0;    left: 0;   border-top-width: 1.5px; border-left-width: 1.5px; }
  .corner.tr { top: 0;    right: 0;  border-top-width: 1.5px; border-right-width: 1.5px; }
  .corner.bl { bottom: 0; left: 0;   border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .corner.br { bottom: 0; right: 0;  border-bottom-width: 1.5px; border-right-width: 1.5px; }

  .edge {
    position: absolute;
    z-index: 9;
    border-color: hsl(var(--border));
    border-style: dotted;
    border-width: 0;
  }
  .edge-top    { top: 0;    left: 10px; right: 10px;  border-top-width: 1px; }
  .edge-bottom { bottom: 0; left: 10px; right: 10px;  border-bottom-width: 1px; }
  .edge-left   { left: 0;   top: 10px;  bottom: 10px; border-left-width: 1px; }
  .edge-right  { right: 0;  top: 10px;  bottom: 10px; border-right-width: 1px; }

</style>
