---
const links = [
  { name: 'home', href: '/' },
  { name: 'projects', href: '/projects' },
  { name: 'blog', href: '/writing' },
  { name: 'snippet', href: '/snippet' },
  { name: 'frames', href: '/frames' },
  { name: 'about', href: '/about' },
];
---
<nav class="layout flex items-center gap-4 py-3 relative">
  {links.map((link) => (
    <a href={link.href} class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground">
      {link.name}
    </a>
  ))}

  <button
    id="command-bar-trigger"
    class="ml-auto flex items-center gap-2 border border-border px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
    aria-label="Search"
  >
    search <kbd class="text-[10px]">⌘K</kbd>
  </button>

  <button
    id="theme-toggle"
    class="h-4 w-4 rounded-full border-2 border-muted-foreground bg-foreground transition-transform hover:scale-110"
    aria-label="Toggle theme"
  ></button>
</nav>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    if (html.classList.contains('dark')) {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });

  document.getElementById('command-bar-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-command-bar'));
  });
</script>
