---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import CommandBar from '../components/CommandBar';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../site.config';
import '../styles/globals.css';
import '../styles/prosemirror.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  wideLayout?: boolean;
  /** Keep the page out of search results (404). Also drops the canonical. */
  noindex?: boolean;
  /** Extra schema.org node for this page, e.g. a BlogPosting. */
  schema?: Record<string, unknown>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage,
  wideLayout = false,
  noindex = false,
  schema,
} = Astro.props;

const imageUrl = `${siteConfig.url}/og/${ogImage ?? 'home'}.webp`;
// Same form as the sitemap: no trailing slash except the root.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), siteConfig.url).href;
const person = {
  '@type': 'Person',
  '@id': `${siteConfig.url}/#person`,
  name: siteConfig.author.name,
  alternateName: ['Chandra Prakash Darji', 'Chandra'],
  url: siteConfig.url,
  image: 'https://github.com/Chandraprakash-Darji.png',
  jobTitle: 'Software engineer',
  email: 'mailto:me@elregaldo.com',
  address: { '@type': 'PostalAddress', addressCountry: 'IN' },
  knowsAbout: ['TypeScript', 'React', 'Go', 'Node.js', 'Bun', 'Kubernetes', 'Terraform', 'DevOps'],
  sameAs: ['https://github.com/Chandraprakash-Darji', siteConfig.author.twitterUrl, 'https://x.com/chandra_7852'],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      url: siteConfig.url,
      name: 'elregaldo',
      alternateName: siteConfig.author.name,
      description: siteConfig.description,
      inLanguage: 'en',
      publisher: { '@id': `${siteConfig.url}/#person` },
    },
    ...(schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <script is:inline>
      (function() {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
          if (localStorage.getItem('pixel-theme') === 'pixel') {
            document.documentElement.classList.add('pixel');
          }
        } catch (e) {}

        document.addEventListener('astro:before-swap', function(event) {
          event.newDocument.documentElement.classList.toggle(
            'dark',
            localStorage.getItem('theme') !== 'light'
          );
          event.newDocument.documentElement.classList.toggle(
            'pixel',
            localStorage.getItem('pixel-theme') === 'pixel'
          );
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-geist-mono" />
    <ClientRouter />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={schema?.['@type'] === 'BlogPosting' ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="elregaldo" />
    <meta property="og:locale" content="en_IN" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chandra_7852" />
    <meta name="twitter:creator" content="@chandra_7852" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <Navbar wide={wideLayout} />
    <main>
      <slot />
    </main>
    <Footer wide={wideLayout}><slot name="footer" /></Footer>
    <CommandBar client:only="react" />
  </body>
</html>
<script>
  // Client-side navigation fetches the next page before anything changes on screen; show that a click registered.
  document.addEventListener('astro:before-preparation', () => document.documentElement.classList.add('is-navigating'));
  document.addEventListener('astro:after-swap', () => document.documentElement.classList.remove('is-navigating'));
</script>
