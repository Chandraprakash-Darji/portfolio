---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { formatPostDate } from '../lib/utils';

const slug = (id: string) => id.replace(/\.mdx$/, '');
const byDateDesc = (a: { data: { publishedAt?: string } }, b: { data: { publishedAt?: string } }) =>
  (b.data.publishedAt ?? '').localeCompare(a.data.publishedAt ?? '');

const projects = (await getCollection('projects'))
  .filter((p) => p.data.published !== false)
  .toSorted((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured) || b.data.year.localeCompare(a.data.year));

const posts = (await getCollection('blog')).filter((p) => p.data.published !== false).toSorted(byDateDesc).slice(0, 5);
const snippets = (await getCollection('snippets')).filter((p) => p.data.published !== false).toSorted(byDateDesc).slice(0, 3);

// Every section renders the same row: title on the left, date or year on the right.
const sections = [
  {
    label: 'work',
    all: { href: '/projects', text: 'all projects →', event: 'all projects' },
    rows: projects.map((p) => ({
      href: `/projects/${slug(p.id)}`,
      title: p.data.title,
      meta: p.data.year,
      track: `window.umami?.track('project-open',{slug:'${slug(p.id)}'})`,
    })),
  },
  {
    label: 'writing',
    all: { href: '/writing', text: 'all posts →', event: 'all posts' },
    rows: posts.map((p) => ({
      href: `/writing/${slug(p.id)}`,
      title: p.data.title,
      meta: formatPostDate(p.data.publishedAt),
      track: `window.umami?.track('card-click',{collection:'blog',slug:'${slug(p.id)}'})`,
    })),
  },
  {
    label: 'snippets',
    all: { href: '/snippet', text: 'all snippets →', event: 'all snippets' },
    rows: snippets.map((p) => ({
      href: `/writing/${slug(p.id)}`,
      title: p.data.title,
      meta: formatPostDate(p.data.publishedAt),
      track: `window.umami?.track('card-click',{collection:'snippets',slug:'${slug(p.id)}'})`,
    })),
  },
];

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout ogImage="home">
  <div class="layout tui-home space-y-14 py-20">
    <section class="space-y-4 leading-relaxed">
      <p>
        i'm chandra, a software engineer in india. i build
        <strong class="font-medium text-foreground">backends that hold under load</strong>
        and pick the tool that fits the actual scale, not the one everyone's writing about.
      </p>
      <p class="text-muted-foreground">
        i write about the decisions that don't make it into the readme: the architecture calls, the cost
        mistakes, the things you only figure out by shipping.
      </p>
      <p class="text-muted-foreground">
        dms are open on <a class="underline underline-offset-4 hover:text-foreground" href={siteConfig.author.twitterUrl} {...ext} data-umami-event="social-click" data-umami-event-name="twitter">x</a>,
        code is on <a class="underline underline-offset-4 hover:text-foreground" href="https://github.com/Chandraprakash-Darji" {...ext} data-umami-event="social-click" data-umami-event-name="github">github</a>,
        or <a class="underline underline-offset-4 hover:text-foreground" href="mailto:me@elregaldo.com" data-umami-event="hero-link" data-umami-event-name="email">email me</a>.
        {siteConfig.availableForWork && (
          <>open to freelance work, <a class="underline underline-offset-4 hover:text-foreground" href={siteConfig.calLink} {...ext} data-umami-event="cta-click" data-umami-event-name="book-a-call">book a call</a>.</>
        )}
      </p>
    </section>

    {sections.map((s) => (
      <section>
        <h2 class="mb-4 flex items-baseline justify-between text-sm text-muted-foreground">
          <span>{s.label}</span>
          <a href={s.all.href} class="hover:text-foreground" data-umami-event="nav-click" data-umami-event-link={s.all.event}>{s.all.text}</a>
        </h2>
        <ul class="space-y-3">
          {s.rows.map((r) => (
            <li>
              <a href={r.href} class="flex items-baseline gap-3" onclick={r.track}>
                <span class="min-w-0 truncate text-foreground">{r.title}</span>
                <span class="ml-auto shrink-0 text-sm text-muted-foreground/60">{r.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
