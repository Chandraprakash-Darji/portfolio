---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCards from '../components/BlogCards.astro';
import ProjectCards from '../components/ProjectCards.astro';
import NowSection from "../components/NowSection.astro";
import { Icons } from '../components/icons';
import { LiveClock } from '../components/hero/LiveClock';
import { siteConfig } from '../site.config';
import { Code2, MapPin, Mail, Link, User, Calendar } from 'lucide-react';
---

<BaseLayout ogImage="home">
  <div class="layout tui-home space-y-12 py-20">
    <!-- Hero panel — title embedded in top border -->
    <section class="tui-panel">
      <span class="tui-title">chandra@elregaldo</span>

      <!-- Profile row: avatar + name + role -->
      <div class="flex items-center gap-4 border-b border-border p-4 pt-5">
        <img
          src="https://github.com/Chandraprakash-Darji.png"
          alt={siteConfig.author.name}
          width="72"
          height="72"
          class="rounded-full border border-border"
          transition:name="avatar"
        />
        <div>
          <h1 class="text-xl font-bold tracking-tight">{siteConfig.author.name}</h1>
          <p class="mt-0.5 font-mono text-sm text-muted-foreground">Software Engineer</p>
        </div>

        {siteConfig.availableForWork && (
          <span class="ml-auto inline-flex shrink-0 items-center gap-1.5 border border-border px-2.5 py-1 font-mono text-[10px] uppercase tracking-widest">
            <span class="text-[hsl(var(--success))]" aria-hidden="true">✓</span>
            <span class="text-muted-foreground">available for work</span>
          </span>
        )}
      </div>

      <!-- Info grid: 2 columns -->
      <div class="grid grid-cols-1 divide-y divide-border border-b border-border sm:grid-cols-2 sm:divide-x sm:divide-y-0">
        <!-- Left column -->
        <div class="divide-y divide-border">
          <div class="flex items-center gap-2.5 px-3 py-2.5 font-mono text-sm text-muted-foreground">
            <Code2 size={14} className="shrink-0 text-foreground/50" />
            <span>Software Engineer</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2.5 font-mono text-sm text-muted-foreground">
            <MapPin size={14} className="shrink-0 text-foreground/50" />
            <span>India</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2.5 font-mono text-sm text-muted-foreground">
            <Link size={14} className="shrink-0 text-foreground/50" />
            <a
              href={siteConfig.url}
              class="accent-link truncate"
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="hero-link"
              data-umami-event-name="website"
            >
              www.elregaldo.com
            </a>
          </div>
        </div>

        <!-- Right column -->
        <div class="divide-y divide-border">
          <LiveClock client:load />
          <div class="flex items-center gap-2.5 px-3 py-2.5 font-mono text-sm text-muted-foreground">
            <Mail size={14} className="shrink-0 text-foreground/50" />
            <a
              href="mailto:prakashchandra3786@gmail.com"
              class="accent-link truncate"
              data-umami-event="hero-link"
              data-umami-event-name="email"
            >
              prakashchandra3786@gmail.com
            </a>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2.5 font-mono text-sm text-muted-foreground">
            <User size={14} className="shrink-0 text-foreground/50" />
            <span>he/him</span>
          </div>
        </div>
      </div>

      <!-- Social icons row -->
      <div class="flex items-center gap-1 p-3">
        <a
          href="https://twitter.com/chandra_7852"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter / X"
          class="flex h-8 w-8 items-center justify-center border border-border text-muted-foreground transition-colors hover:border-[hsl(var(--accent-blue))]/40 hover:text-[hsl(var(--accent-blue))]"
          data-umami-event="social-click"
          data-umami-event-name="twitter"
        >
          <Icons.x className="h-3.5 w-3.5" />
        </a>
        <a
          href="https://github.com/Chandraprakash-Darji"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex h-8 w-8 items-center justify-center border border-border text-muted-foreground transition-colors hover:border-[hsl(var(--accent-blue))]/40 hover:text-[hsl(var(--accent-blue))]"
          data-umami-event="social-click"
          data-umami-event-name="github"
        >
          <Icons.github className="h-3.5 w-3.5" />
        </a>

        {siteConfig.availableForWork && (
          <a
            href={siteConfig.calLink}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto inline-flex items-center gap-1.5 border border-foreground bg-foreground px-3 py-1.5 font-mono text-xs text-background transition-opacity hover:opacity-90"
            data-umami-event="cta-click"
            data-umami-event-name="book-a-call"
          >
            <Calendar size={13} className="shrink-0" />
            Book a call
          </a>
        )}
      </div>
    </section>

    <div class="tui-divider"><span aria-hidden="true">·</span></div>

    <NowSection />

    <div class="tui-divider"><span aria-hidden="true">·</span></div>

    <!-- Hello / About -->
    <section>
      <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-widest text-foreground">Hello</h2>
      <div class="space-y-3 leading-relaxed text-muted-foreground">
        <p><strong class="text-foreground">software engineer.</strong> full stack, freelancer, whatever the badge is. the title isn't the interesting part.</p>
        <p>i build <strong class="text-foreground">backends that hold under load</strong> and pick the tool that fits the actual scale — not the one everyone's writing about.</p>
        <p>i write about the decisions that don't make it into the README. the <strong class="text-foreground">architecture calls</strong>, the cost mistakes, the things you only figure out by shipping.</p>
      </div>
    </section>

    <!-- Experience -->
    <section>
      <div class="mb-3 flex items-center justify-between">
        <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Work history
        </span>
      </div>
      <div class="space-y-4">
        <article class="rounded-lg border border-border p-4">
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-medium leading-snug text-foreground">Co-Founder & CTO · Pixelwand / Timebase</h3>
            <p class="text-xs text-muted-foreground">
              Started Pixelwand as a product engineering studio, then helped establish Timebase for services while Pixelwand evolved into a CRM product company. Lead a 10-person team and own architecture, infrastructure, roadmap, and delivery.
            </p>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] text-muted-foreground/60">
              <span>May 2022 — now</span>
              <span aria-hidden="true">·</span>
              <span>React</span>
              <span>Next.js</span>
              <span>Express</span>
              <span>AWS</span>
              <span>Python</span>
              <span>Go</span>
              <span>React Native</span>
            </div>
          </div>
        </article>

        <article class="rounded-lg border border-border p-4">
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-medium leading-snug text-foreground">Chief Technology Officer · Valuemetrix</h3>
            <p class="text-xs text-muted-foreground">
              Led technology strategy, architecture, and engineering delivery for the product until its acquisition.
            </p>
            <div class="font-mono text-[10px] text-muted-foreground/60">Jan 2024 — Sep 2025</div>
          </div>
        </article>

      </div>
    </section>
    <div class="tui-divider"><span aria-hidden="true">·</span></div>

    <!-- Work -->
    <section>
      <div class="mb-3 flex items-center justify-between">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-foreground">Work</span>
        <a
          href="/projects"
          class="accent-link font-mono text-xs"
          data-umami-event="nav-click"
          data-umami-event-link="all projects"
        >
          all projects →
        </a>
      </div>
      <ProjectCards limit={3} />
      {siteConfig.availableForWork && (
        <div class="mt-5 flex flex-col gap-3 border border-border p-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium text-foreground">Have something to build?</p>
            <p class="mt-0.5 text-xs text-muted-foreground">I'm currently open to freelance and contract work.</p>
          </div>
          <a
            href={siteConfig.calLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center justify-center gap-1.5 border border-foreground bg-foreground px-3 py-1.5 font-mono text-xs text-background transition-opacity hover:opacity-90"
            data-umami-event="cta-click"
            data-umami-event-name="book-a-call-work"
          >
            <Calendar size={13} className="shrink-0" />
            Book a call
          </a>
        </div>
      )}
    </section>

    <div class="tui-divider"><span aria-hidden="true">·</span></div>

    <!-- Writing -->
    <section>
      <div class="mb-3 flex items-center justify-between">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-foreground">Writing</span>
        <a
          href="/writing"
          class="accent-link font-mono text-xs"
          data-umami-event="nav-click"
          data-umami-event-link="all posts"
        >
          all posts →
        </a>
      </div>
      <BlogCards collection="blog" limit={3} />
    </section>

    <div class="tui-divider"><span aria-hidden="true">·</span></div>

    <!-- Snippets -->
    <section>
      <div class="mb-3 flex items-center justify-between">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-foreground">Snippets</span>
        <a
          href="/snippet"
          class="accent-link font-mono text-xs"
          data-umami-event="nav-click"
          data-umami-event-link="all snippets"
        >
          all snippets →
        </a>
      </div>
      <BlogCards collection="snippets" limit={3} />
    </section>
  </div>
</BaseLayout>
