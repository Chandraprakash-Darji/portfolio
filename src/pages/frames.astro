---
import BaseLayout from '../layouts/BaseLayout.astro';
import FramesLightbox from '../components/FramesLightbox';
import { siteConfig } from '../site.config';
import { getBlobImages } from '../lib/blob-images';

const images = await getBlobImages();
---

<BaseLayout
  title={`Frames — ${siteConfig.author.name}`}
  description="photos i capture. full quality, no recompression."
  ogImage="frames"
>
  <div class="layout py-20">
    <div class="mb-4 flex items-center justify-between">
      <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Frames</span>
      <span class="font-mono text-xs text-muted-foreground"
        >{images.length} frame{images.length !== 1 ? 's' : ''}</span
      >
    </div>

    {images.length === 0 ? (
      <p class="font-mono text-sm text-muted-foreground">
        no frames yet. upload some to vercel blob.
      </p>
    ) : (
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>button]:mb-4 [&>button]:block">
        {images.map((img, i) => (
          <button
            class="break-inside-avoid border border-border w-full text-left transition-colors hover:border-foreground/30 bg-no-repeat bg-cover bg-center"
            style={`background-image: url(${img.blurDataUrl})`}
            onclick={`window.__openFramesLightbox?.(${i})`}
          >
            <img
              src={img.url}
              alt={img.pathname.split('/').pop()?.replace(/\.[^.]+$/, '') ?? ''}
              width={img.width}
              height={img.height}
              loading="lazy"
              decoding="async"
              class="w-full h-auto block transition-opacity duration-300"
              onload="this.style.opacity='1'"
              style="opacity:0"
            />
          </button>
        ))}
      </div>
    )}
  </div>

  <FramesLightbox images={images} client:load />
</BaseLayout>
